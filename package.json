{
  "name": "steam-weekly-demos",
  "version": "1.0.0",
  "description": "Weekly crawler for Steam Mac demos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc",
    "crawl": "node --import tsx/esm src/crawler.ts",
    "dev": "tsx src/crawler.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
