{
  "name": "steam-weekly-demos",
  "version": "1.0.0",
  "description": "Weekly crawler for Steam Mac demos",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "crawl": "node --import tsx/esm src/crawler.ts",
    "dev": "tsx src/crawler.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
